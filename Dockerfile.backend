# ── Build arg ─────────────────────────────────────────────────────────────────
ARG USE_GPU=false

# ── Base image ────────────────────────────────────────────────────────────────
# GPU path: nvidia/cuda image already provides libcuda.so so mmcv can compile
# CPU path: plain python:3.10-slim is sufficient
FROM python:3.10-slim AS cpu-base
FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04 AS gpu-base

# ── Select the right base via a transparent re-stage ─────────────────────────
# We use a shell-level ARG trick: both stages are defined above;
# the final FROM picks one of them based on USE_GPU.
FROM cpu-base AS final-false
FROM gpu-base  AS final-true

# hadolint ignore=DL3006
FROM final-${USE_GPU} AS final

ARG USE_GPU=false

# ── System packages ───────────────────────────────────────────────────────────
# GPU base is Ubuntu 22.04; CPU base is Debian-slim — both use apt.
RUN apt-get update -o Acquire::Retries=3 && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libgl1 \
        git \
        g++ \
        gcc \
        build-essential \
        wget \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && ln -sf /usr/bin/pip3    /usr/bin/pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Step 1: PyTorch ───────────────────────────────────────────────────────────
# GPU  → torch 2.1.0 + CUDA 11.8  (matches the cuda:11.8 base image)
# CPU  → torch 2.1.0 cpu-only
RUN if [ "$USE_GPU" = "true" ]; then \
        pip install --no-cache-dir \
            torch==2.1.0+cu118 \
            torchvision==0.16.0+cu118 \
            torchaudio==2.1.0+cu118 \
            --index-url https://download.pytorch.org/whl/cu118; \
    else \
        pip install --no-cache-dir \
            torch==2.8.0+cpu\
            torchvision==0.23.0 \
            torchaudio==2.8.0 \
            --extra-index-url https://download.pytorch.org/whl/cpu; \
    fi

# ── Step 2: openmim ───────────────────────────────────────────────────────────
RUN pip install --no-cache-dir openmim

# ── Step 3: mmengine (pure-Python, no CUDA wheel needed) ─────────────────────
RUN pip install --no-cache-dir mmengine==0.10.7

# ── Step 4: mmcv — use the pre-built wheel index so mim never tries to compile
# torch 2.1.0 + cu118 → mmcv 2.1.0 wheel exists on openmmlab CDN
# torch 2.1.0 + cpu   → mmcv 2.1.0 cpu wheel also exists
RUN if [ "$USE_GPU" = "true" ]; then \
        pip install --no-cache-dir \
            mmcv==2.1.0 \
            -f https://download.openmmlab.com/mmcv/dist/cu118/torch2.1.0/index.html; \
    else \
        pip install --no-cache-dir \
            mmcv==2.1.0 \
            -f https://download.openmmlab.com/mmcv/dist/cpu/torch2.1.0/index.html; \
    fi

# ── Step 5: mmsegmentation from source ───────────────────────────────────────
RUN git clone https://github.com/open-mmlab/mmsegmentation.git /app/mmsegmentation && \
    cd /app/mmsegmentation && \
    pip install --no-cache-dir -e . --no-deps && \
    pip install --no-cache-dir -r requirements/optional.txt || true

# ── Step 6: project requirements ─────────────────────────────────────────────
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Step 7: application code ──────────────────────────────────────────────────
COPY backend/ .

RUN mkdir -p uploads history_images

EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]