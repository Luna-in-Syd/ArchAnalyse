# ── Backend secrets ───────────────────────────────────────────────────────────
# Generate a strong key:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# ── Default admin account (created on first run) ──────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@archanalyse.com

# ── Wall segmentation model paths ─────────────────────────────────────────────
# Download best_mIoU_iter.pth from: [add your link here]
# Place it at: backend/best_mIoU_iter.pth
SEG_CONFIG=backend/segformer_b2_wall.py
SEG_CHECKPOINT=backend/best_mIoU_iter.pth
SEG_DEVICE=cpu   # or cuda:0
